    },
    "phone": {
      "type": "integer"
    },
    "organization": {
      "type": "string"
    },
    "product": {
      "type": "string"
    },
    "message": {
      "type": "text"
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "Inquiry",
        "Service",
        "Job",
        "Remarks",
        "Complaint"
      ]
    },
    "source": {
      "type": "string"
    },
    "update": {
      "type": "enumeration",
      "default": "New",
      "enum": [
        "New",
        "Read",
        "Replied"
      ]
    }
  }
